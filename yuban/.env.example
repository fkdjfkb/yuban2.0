# auto: Codex CLI first, then fixed replies
# codex: Codex CLI, falling back to fixed replies
# deepseek: DeepSeek API, falling back to fixed replies
# fixed: deterministic demo replies only
AI_PROVIDER=auto
PORT=3000

# Optional Codex CLI overrides
CODEX_CLI_PATH=codex
# CODEX_MODEL=
CODEX_TIMEOUT_MS=90000

# DeepSeek backup (fill these in when switching providers)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=60000
